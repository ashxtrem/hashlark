<?xml version="1.0" encoding="utf-8"?>
<!-- Folders whose files the FileProvider may share, so finished downloads open in other apps. -->
<paths>
    <!-- Download/Hashlark, the default download folder. -->
    <external-path name="downloads" path="Download/Hashlark/" />
    <!-- The app's own Downloads folder (the fallback). -->
    <external-files-path name="app_downloads" path="Download/" />
</paths>
